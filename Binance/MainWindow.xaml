<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Binance"
        xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Class="Binance.MainWindow"
        mc:Ignorable="d"
        Topmost="True"
        ResizeMode="CanMinimize"
        Width="300"
        Title="Binance" SizeToContent="Height">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value=" 25"/>
        </Style>

        
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Margin="10">
            <TabItem Header="Profit">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>

                    </Grid.RowDefinitions>
                    <TextBlock Text="Start"/>
                    <TextBox x:Name="txtStartAmount" Text="200" Grid.Column="1"/>

                    <TextBlock Text="Percent" Grid.Row="1"/>
                    <TextBox x:Name="txtPercent" Grid.Column="1" Grid.Row="1" Text="5"/>
                    
                    <TextBlock Text="Days" Grid.Row="2"/>
                    <TextBox x:Name="txtDays"  Grid.Column="1" Grid.Row="2" Text="1"/>

                    <TextBlock Text="Total" Grid.Row="3"/>
                    <TextBox x:Name="txtTotal" Grid.Column="1" Grid.Row="3" IsReadOnly="True"/>

                    <Button x:Name="btnClear" Content="Calculate" Click="btnClear_Click" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Price">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>

                    </Grid.RowDefinitions>
                    <TextBlock Text="Current Price"/>
                    <TextBox x:Name="txtCurrentPrice" Grid.Column="1" TextChanged="txtPrice_TextChanged"/>

                    <TextBlock Text="Percent" Grid.Row="1"/>
                    <TextBox x:Name="txtOrderPercent" Grid.Column="1" Grid.Row="1" Text="5" Foreground="Blue" MouseDoubleClick="TextBox_MouseDoubleClick"/>
                    
                    <TextBlock Text="Upper Price" Grid.Row="2"/>
                    <TextBox x:Name="txtUpperPrice" Grid.Column="2" Grid.Row="2" IsReadOnly="True" Foreground="Green" MouseDoubleClick="TextBox_MouseDoubleClick"/>

                    <TextBlock Text="Lower Price" Grid.Row="3"/>
                    <TextBox x:Name="txtLowerPrice"  Grid.Column="1" Grid.Row="3"  IsReadOnly="True" Foreground="Red" MouseDoubleClick="TextBox_MouseDoubleClick"/>

                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
